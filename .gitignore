tests/_local/

# Logs and temp files
*.log
*.bak
*.tmp
*.swp
*~

# Puppeteer screenshot artifacts
.tmp-puppeteer-profiles/
.puppeteer-cache/
screenshots/

# High-DPI mockup renders are kept local only; the 1× PNGs are the committed assets.
*@2x.png


# Root dotfiles and dot-folders are local tool state (.claude, .codegraph,
# .impeccable, .mcp.json, .vitest, ...); only the repo's own config is shared.
/.*
!/.gitignore
!/.github/
