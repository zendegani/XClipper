.env
.env.local
.env.*.local

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.sublime-*

# Test HTML fixtures (large, regenerated locally; not worth versioning)
tests/fixtures/*.html
# This article's AST snapshot is an order of magnitude larger than the rest;
# its .md snapshot already covers the same extraction. Regenerated locally.
tests/fixtures/DeRonin_-2076690611399176506.ast.json

